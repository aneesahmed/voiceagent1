GEMINI_API_KEY=your gemini api key

# Optional overrides -- defaults shown
CHAT_MODEL=gemini-2.5-flash
STT_MODEL=gemini-2.5-flash
TTS_MODEL=gemini-2.5-flash-preview-tts
TTS_VOICE=Aoede
HOST=0.0.0.0
PORT=8001

# -- Twilio (phone) integration -- leave blank until a real account/number
# is set up. Easiest way to fill these in: run the backend and use the
# Settings page at /settings-ui instead of hand-editing this file.
TWILIO_ACCOUNT_SID=your twilio account sid
TWILIO_AUTH_TOKEN=your twilio auth token
TWILIO_PHONE_NUMBER=your twilio phone number
PUBLIC_BASE_URL=

# -- Twilio API Key + TwiML App -- only needed for the browser WebRTC test
# caller at /twilio-test (testing Twilio without a real phone). Get the API
# Key SID/Secret from console.twilio.com > Account > Keys & Credentials >
# API keys & tokens; TWILIO_TWIML_APP_SID is normally set automatically by
# the "Create/Update TwiML App" button on /settings-ui.
TWILIO_API_KEY_SID=your twilio api key sid
TWILIO_API_KEY_SECRET=your twilio api key secret
TWILIO_TWIML_APP_SID=

# -- WhatsApp Business (Meta Cloud API) integration -- leave blank until a
# real Meta app/number is set up. See the Integrations panel in the
# frontend for setup steps.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=